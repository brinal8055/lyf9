# Lyf9 AI worker environment
# Copy to .env for local development. Do not commit real secrets.

# staging/production workers must fail closed if Supabase or DATABASE_URL is missing.
APP_ENV=development
WORKER_ID=local-worker

# Supabase/Auth/Postgres
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://user:password@localhost:5432/lyf9
REDIS_URL=redis://localhost:6379/0
QUEUE_NAME=report-processing
WORKFLOW_PROVIDER=database
WORKER_CONCURRENCY=1
WORKER_LEASE_SECONDS=300
WORKER_MAX_ATTEMPTS=3
PROCESSING_VERSION=v1
ENABLE_WORKER_LOOP=false
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Private storage
STORAGE_PROVIDER=local
ALLOW_MOCK_STORAGE_IN_DEPLOYED_ENV=false
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_REPORT_BUCKET=lyf9-private-beta-reports
STAGING_S3_BUCKET=
PRODUCTION_S3_BUCKET=
S3_UPLOAD_URL_EXPIRY_SECONDS=900
S3_DOWNLOAD_URL_EXPIRY_SECONDS=300
MAX_REPORT_FILE_SIZE_BYTES=20971520
MALWARE_SCANNER_PROVIDER=mock
ALLOW_MOCK_MALWARE_SCAN_IN_DEPLOYED_ENV=false
MALWARE_SCANNER_MODE=remote
CLAMAV_ENDPOINT=

# Parser/OCR/AI
# Valid providers: mock, marker. Textract belongs under OCR_PROVIDER.
DOCUMENT_PARSER_PROVIDER=mock
ALLOW_MOCK_DOCUMENT_PARSER_IN_DEPLOYED_ENV=false
MARKER_COMMAND=
MARKER_API_URL=
MARKER_TIMEOUT_SECONDS=120
MIN_EXTRACTED_TEXT_CHARS=500
# Valid providers: mock, textract.
OCR_PROVIDER=mock
ALLOW_MOCK_OCR_IN_DEPLOYED_ENV=false
AWS_TEXTRACT_REGION=ap-south-1
OCR_TIMEOUT_SECONDS=180
AI_PROVIDER=mock
ALLOW_MOCK_AI_IN_DEPLOYED_ENV=false
OPENAI_API_KEY=
OPENAI_MODEL_EXTRACTION=
OPENAI_MODEL_EXPLANATION=
OPENAI_MODEL_DOCTOR_SUMMARY=
OPENAI_TIMEOUT_SECONDS=120
BIOMARKER_EXTRACTION_PROMPT_VERSION=v1
PATIENT_EXPLANATION_PROMPT_VERSION=v1
DOCTOR_SUMMARY_PROMPT_VERSION=v1
SAFETY_RULES_VERSION=v1

# Email and observability
EMAIL_PROVIDER=placeholder
RESEND_API_KEY=
AWS_SES_REGION=ap-south-1
POSTHOG_KEY=
POSTHOG_HOST=
SENTRY_DSN=
LOG_LEVEL=info
