# Lyf9 AI web app environment
# Copy to apps/web/.env.local for local development. Do not commit real secrets.

# Runtime mode. Use local/development for scaffold-only work; staging/production must use Supabase.
APP_ENV=development

# Public Supabase browser config. Uses the anon key only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public app origin used for redirects and links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local scaffold-only fallback secrets. Do not use for real PHI beta.
# Local auth fallback runs only when APP_ENV=local/development and this flag is true.
ENABLE_LOCAL_AUTH_FALLBACK=true
LYF9_AUTH_SECRET=replace-with-32-byte-random-secret
LYF9_REPORT_URL_SECRET=replace-with-32-byte-random-secret
LYF9_BETA_ACCESS_MODE=open
LYF9_BETA_INVITE_CODE=
LYF9_BETA_ALLOWLIST_EMAILS=

# Server-only secret for Next.js route handlers if the BFF runs inside apps/web.
# Never prefix this with NEXT_PUBLIC_ and never expose it to browser bundles.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
REDIS_URL=

# Private report storage. Use mock/local only for APP_ENV=local/development/test.
STORAGE_PROVIDER=mock
ALLOW_MOCK_STORAGE_IN_DEPLOYED_ENV=false
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_REPORT_BUCKET=
S3_UPLOAD_URL_EXPIRY_SECONDS=900
S3_DOWNLOAD_URL_EXPIRY_SECONDS=300
MAX_REPORT_FILE_SIZE_BYTES=20971520

# Malware scanning. Staging/production must use a real scanner before PHI beta.
MALWARE_SCANNER_PROVIDER=mock
ALLOW_MOCK_MALWARE_SCAN_IN_DEPLOYED_ENV=false

# Durable processing workflow. Database workflow is the private beta default.
WORKFLOW_PROVIDER=database
WORKER_ID=local-worker
WORKER_CONCURRENCY=1
WORKER_LEASE_SECONDS=300
WORKER_MAX_ATTEMPTS=3
PROCESSING_VERSION=v1
ENABLE_WORKER_LOOP=false

# Document extraction. Use mock only for APP_ENV=local/development/test.
DOCUMENT_PARSER_PROVIDER=mock
ALLOW_MOCK_DOCUMENT_PARSER_IN_DEPLOYED_ENV=false
MARKER_COMMAND=
MARKER_API_URL=
MARKER_TIMEOUT_SECONDS=120
MIN_EXTRACTED_TEXT_CHARS=500

# OCR fallback. Use mock only for APP_ENV=local/development/test.
OCR_PROVIDER=mock
ALLOW_MOCK_OCR_IN_DEPLOYED_ENV=false
AWS_TEXTRACT_REGION=ap-south-1
OCR_TIMEOUT_SECONDS=180

# Schema-first AI. Use mock only for APP_ENV=local/development/test.
AI_PROVIDER=mock
ALLOW_MOCK_AI_IN_DEPLOYED_ENV=false
GEMINI_API_KEY=
GEMINI_MODEL_EXTRACTION=gemini-2.5-flash
GEMINI_MODEL_EXPLANATION=gemini-2.5-flash
GEMINI_MODEL_DOCTOR_SUMMARY=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL_EXTRACTION=
OPENAI_MODEL_EXPLANATION=
OPENAI_MODEL_DOCTOR_SUMMARY=
OPENAI_TIMEOUT_SECONDS=120
BIOMARKER_EXTRACTION_PROMPT_VERSION=v1
PATIENT_EXPLANATION_PROMPT_VERSION=v1
DOCTOR_SUMMARY_PROMPT_VERSION=v1
SAFETY_RULES_VERSION=v1

# Inngest report-processing saga. Set both keys in deployed environments.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Replaceable payment provider. Keep public payments disabled for private beta.
PAYMENT_PROVIDER=sandbox
ALLOW_SANDBOX_PAYMENTS_IN_DEPLOYED_ENV=false
PAYMENTS_PUBLIC_LAUNCH_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional email and PHI-safe observability providers.
EMAIL_PROVIDER=
SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=
LOG_LEVEL=info

# Public paid launch remains disabled.
LYF9_PUBLIC_PAID_LAUNCH_ENABLED=false
