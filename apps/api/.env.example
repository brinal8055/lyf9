# Lyf9 AI API environment
# Copy to .env for local development. Do not commit real secrets.

# staging/production must fail closed if Supabase or DATABASE_URL is missing.
APP_ENV=development
APP_BASE_URL=http://localhost:3000
API_HOST=0.0.0.0
API_PORT=8000
ADMIN_ALLOWLIST=admin@lyf9.ai
BETA_INVITE_REQUIRED=true

# Supabase/Auth/Postgres
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://user:password@localhost:5432/lyf9
REDIS_URL=redis://localhost:6379/0

# Private storage
STORAGE_PROVIDER=local
ALLOW_MOCK_STORAGE_IN_DEPLOYED_ENV=false
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_REPORT_BUCKET=lyf9-private-beta-reports
S3_UPLOAD_URL_EXPIRY_SECONDS=900
S3_DOWNLOAD_URL_EXPIRY_SECONDS=300
MAX_REPORT_FILE_SIZE_BYTES=20971520
MALWARE_SCANNER_PROVIDER=mock
ALLOW_MOCK_MALWARE_SCAN_IN_DEPLOYED_ENV=false

# Auth validation when replacing local web auth
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
AUTH_JWT_PUBLIC_KEY=

# AI and safety
OPENAI_API_KEY=
AI_PROVIDER=openai
OPENAI_MODEL_EXTRACTION=
OPENAI_MODEL_EXPLANATION=
OPENAI_MODEL_DOCTOR_SUMMARY=
OPENAI_TIMEOUT_SECONDS=120
BIOMARKER_EXTRACTION_PROMPT_VERSION=v1
PATIENT_EXPLANATION_PROMPT_VERSION=v1
DOCTOR_SUMMARY_PROMPT_VERSION=v1
SAFETY_RULES_VERSION=v1

# Workflow/OCR
WORKFLOW_PROVIDER=database
WORKER_ID=local-worker
WORKER_LEASE_SECONDS=300
WORKER_MAX_ATTEMPTS=3
ENABLE_WORKER_LOOP=false
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
WORKER_CONCURRENCY=1
PROCESSING_VERSION=v1
OCR_PROVIDER=mock
AWS_TEXTRACT_REGION=ap-south-1

# Payments and email
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
EMAIL_PROVIDER=placeholder
RESEND_API_KEY=
AWS_SES_REGION=ap-south-1
EMAIL_FROM=care@lyf9.ai

# Observability
POSTHOG_KEY=
POSTHOG_HOST=
SENTRY_DSN=
LOG_LEVEL=info
